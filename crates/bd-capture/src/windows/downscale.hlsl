// Уменьшение кадра перед кодированием.
//
// Задача узкая: взять BGRA-текстуру захвата и отдать её же вдвое или
// вчетверо меньше, не вынимая пиксели из GPU. Копия в системную
// память здесь стоила бы 5–10 мс на кадр — ровно то, что запрещает
// §4.2.3 CLAUDE.md.

Texture2D<float4> Source : register(t0);
SamplerState Bilinear : register(s0);

struct VsOut
{
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
};

// Полноэкранный треугольник без буфера вершин.
//
// Три вершины вместо четырёх — не микрооптимизация: у треугольника
// нет диагонального шва, вдоль которого GPU считает пиксели дважды.
VsOut vs_main(uint id : SV_VertexID)
{
    VsOut output;
    output.uv = float2((id << 1) & 2, id & 2);
    output.position = float4(output.uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
    return output;
}

float4 ps_main(VsOut input) : SV_TARGET
{
    // Билинейная фильтрация задана семплером, а не считается здесь.
    //
    // Брать один пиксель из четырёх (point sampling) было бы дешевле,
    // но давало бы рябь на тексте: тонкие линии то попадают в выборку,
    // то нет, и буквы «дрожат» при малейшем сдвиге окна. Для сценария
    // §7.2 — работа с текстом — это худший из возможных артефактов.
    return Source.Sample(Bilinear, input.uv);
}
