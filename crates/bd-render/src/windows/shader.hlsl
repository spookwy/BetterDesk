// Конверсия NV12 → RGB на GPU.
//
// Копия кадра в системную память здесь была бы катастрофой для бюджета
// задержки (CLAUDE.md §4.2.3), поэтому преобразование делает шейдер:
// текстура декодера идёт прямо в семплеры.
//
// NV12 — это две плоскости в одной текстуре: Y в полном разрешении и
// UV в половинном, чересстрочно. D3D11 отдаёт их как два отдельных
// представления одной поверхности: R8_UNORM для Y и R8G8_UNORM для UV.
// Поэтому семплеров два, а текстура одна.

Texture2D<float>  PlaneY  : register(t0);
Texture2D<float2> PlaneUV : register(t1);
SamplerState      Linear  : register(s0);

// Доля кадра, занятая настоящей картинкой.
//
// Декодер выравнивает высоту до кратной 16 (1080 → 1088), потому что
// H.264 кодирует макроблоками. Нижние строки — служебное дополнение,
// и показывать их нельзя. Множитель приходит с CPU, а не зашит:
// разрешение потока меняется на лету.
cbuffer Crop : register(b0)
{
    float2 UvScale;
    float2 Padding;
};

struct VsOut
{
    float4 Position : SV_POSITION;
    float2 Uv       : TEXCOORD0;
};

// Полноэкранный треугольник без буфера вершин.
//
// Треугольник, а не два для квадрата: на стыке диагонали квадрата
// GPU дважды растеризует пиксели шва. Мелочь, но бесплатная.
VsOut VsMain(uint id : SV_VertexID)
{
    VsOut output;

    // id=0 → (0,0), id=1 → (2,0), id=2 → (0,2).
    float2 uv = float2((id << 1) & 2, id & 2);
    output.Uv = uv * UvScale;

    // UV в координаты клипа: Y инвертирован, потому что текстурные
    // координаты растут вниз, а клип-пространство — вверх.
    output.Position = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);

    return output;
}

float4 PsMain(VsOut input) : SV_TARGET
{
    float  y  = PlaneY.Sample(Linear, input.Uv);
    float2 uv = PlaneUV.Sample(Linear, input.Uv);

    // Limited range (16..235 для Y, 16..240 для UV) — то, что отдаёт
    // аппаратный декодер по умолчанию. Пропустить это преобразование
    // значит получить блёклую картинку с серым вместо чёрного.
    y  = (y - 16.0 / 255.0) * (255.0 / 219.0);
    uv = (uv - 128.0 / 255.0) * (255.0 / 224.0);

    // BT.709 — стандарт для HD. BT.601 дал бы заметный сдвиг оттенков
    // на насыщенных цветах.
    float r = y + 1.5748 * uv.y;
    float g = y - 0.1873 * uv.x - 0.4681 * uv.y;
    float b = y + 1.8556 * uv.x;

    return float4(saturate(float3(r, g, b)), 1.0);
}
