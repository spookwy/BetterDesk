# Rust
/target/
**/*.rs.bk

# Секреты и локальные ключи устройства (docs/security-model.md §3.1)
*.pem
*.key
/.env
/local/

# Node / Tauri (с этапа 7)
node_modules/
/ui/dist/
/ui/src-tauri/target/

# Измерения и логи
/logs/
*.log

# Windows
Thumbs.db
desktop.ini

# Копия дизайн-токенов: её кладёт ui/src-tauri/build.rs при сборке.
# Оригинал — docs/design/tokens.css, и он единственный источник (§6.2).
# Коммитить копию нельзя: она разойдётся с оригиналом, и правка одного
# файла перестанет влиять на то, что видно на экране.
/ui/src/tokens.css

# Артефакты Tauri: генерируются при сборке.
/ui/src-tauri/gen/
