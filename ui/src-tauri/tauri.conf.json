{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterDesk",
  "version": "0.1.0",
  "identifier": "com.betterdesk.shell",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterDesk",
        "width": 880,
        "height": 720,
        "minWidth": 520,
        "minHeight": 520,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["msi"], "icon": ["icons/icon.ico"] }
}
